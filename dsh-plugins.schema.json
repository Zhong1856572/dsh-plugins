{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Zhong1856572/dsh-plugins/dsh-plugins.schema.json",
  "title": "DSH 插件与技能仓库清单",
  "description": "dsh-plugins.json 的结构定义。DSH Skills Manager 扫描仓库时据此索引技能与插件。",
  "type": "object",
  "required": ["version", "repository"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "本 schema 的相对路径"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "清单格式版本号"
    },
    "repository": {
      "type": "object",
      "required": ["owner", "name", "ref"],
      "properties": {
        "owner": {
          "type": "string",
          "description": "GitHub 账号或组织名",
          "examples": ["Zhong1856572"]
        },
        "name": {
          "type": "string",
          "description": "仓库名",
          "examples": ["dsh-plugins"]
        },
        "ref": {
          "type": "string",
          "description": "分支",
          "examples": ["main"]
        },
        "subdirectory": {
          "type": "string",
          "description": "技能所在子目录",
          "examples": ["skills"]
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "已上传技能索引",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": {
            "type": "string",
            "description": "技能标识符，必须是 kebab-case（仅 ASCII 小写字母、数字、连字符）",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "description": "相对仓库根目录的路径",
            "examples": ["skills/numeric-table-anchor-consistency"]
          },
          "description": {
            "type": "string",
            "description": "一句话说明"
          },
          "version": {
            "type": "string",
            "description": "技能版本号"
          },
          "category": {
            "type": "string",
            "description": "分类"
          },
          "updatedAt": {
            "type": "string",
            "description": "最后更新时间（ISO 8601）"
          }
        },
        "additionalProperties": true
      }
    },
    "plugins": {
      "type": "array",
      "description": "已上传插件索引",
      "items": {
        "type": "object",
        "required": ["name", "package"],
        "properties": {
          "name": {
            "type": "string",
            "description": "插件名"
          },
          "package": {
            "type": "string",
            "description": "npm 包名",
            "examples": ["my-dsh-plugin"]
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "install": {
            "type": "string",
            "description": "安装命令"
          }
        },
        "additionalProperties": true
      }
    },
    "updatedAt": {
      "type": "string",
      "description": "清单最后更新时间（ISO 8601）"
    }
  },
  "additionalProperties": false
}
