{
  "name": "@local/inquiry-structure-workbench",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "询单结构式助手：从 Word / Excel 提取结构式图片，按文档从上到下的顺序写入固定模版的「结构式/产品信息」列，导出新的咨询表。全程本机处理。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "scripts",
    "README.md",
    "CONTRACT.md"
  ],
  "keywords": [
    "dsh-workbench",
    "structure",
    "docx",
    "xlsx"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  }
}
